{
  "pdf": "us_invoice.pdf",
  "fields": {
    "invoice_number": {
      "type": "string",
      "description": "Invoice number",
      "required": true,
      "raw": "INV-7781",
      "page": 1,
      "wrong": [
        "INV-7718"
      ]
    },
    "due_date": {
      "type": "date",
      "description": "Payment due date",
      "required": true,
      "raw": "November 2, 2026",
      "page": 1,
      "wrong": [
        "October 3, 2026",
        "November 20, 2026"
      ]
    },
    "total": {
      "type": "number",
      "description": "Total amount due including tax",
      "required": true,
      "raw": "$2,652.13",
      "page": 1,
      "wrong": [
        "$2,450.00",
        "$202.13",
        "$2,625.13"
      ]
    },
    "customer_name": {
      "type": "string",
      "description": "Name of the customer being billed",
      "required": true,
      "raw": "Initech LLC",
      "page": 1,
      "wrong": [
        "Globex Inc."
      ]
    }
  }
}